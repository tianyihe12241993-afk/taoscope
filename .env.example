# ---- TaoScope config ----
# Copy to .env, fill in, then `chmod 600 .env`. Every value below is read by
# docker-compose.yml; anything left blank simply disables that feature.

POSTGRES_USER=taoscope
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taoscope

# Public hostname. Use :80 until a domain points here; then set e.g. tao.example.com
# (Caddy then provisions Let's Encrypt automatically.)
SITE_ADDRESS=:80

TAOSCOPE_JWT_SECRET=generate-with-openssl-rand-hex-32
TAOSCOPE_ADMIN_EMAIL=you@example.com
TAOSCOPE_ADMIN_PASSWORD=changeme

TAOSCOPE_NETWORK=finney
TAOSCOPE_FAST_POLL=12
TAOSCOPE_SNAPSHOT_EVERY=60
TAOSCOPE_NEURON_POLL=900

# Host directory mounted read-only at /work inside the backend. The competition
# adapters read our own submission ids / hotkeys out of the miner tooling's own
# files, so this must point at the mining workspace on THIS host. A host with no
# miner workspace can leave the default: the adapters fall back to their
# built-in ids when the file is absent.
TAOSCOPE_WORKSPACE=/home/dev/work

# ---- phase 2 ----
# Google sign-in stays dormant until PUBLIC_URL is a real https domain.
TAOSCOPE_PUBLIC_URL=
TAOSCOPE_GOOGLE_CLIENT_ID=
TAOSCOPE_GOOGLE_CLIENT_SECRET=
TAOSCOPE_COOKIE_SECURE=false
TAOSCOPE_ALLOWED_EMAILS=you@example.com
TAOSCOPE_MAX_LOGIN_ATTEMPTS=8
# From @BotFather. Empty = bot disabled.
TAOSCOPE_TELEGRAM_BOT_TOKEN=

# ---- Telegram Q&A ----
# Either key works. OpenRouter serves the Anthropic Messages API, so the same
# SDK and tool-calling code runs against it unchanged.
TAOSCOPE_OPENROUTER_API_KEY=
# Management/provisioning key, ONLY for reading account balance on /credits
# (OpenRouter 403s a normal key there). Optional; leave blank to skip the credits panel.
TAOSCOPE_OPENROUTER_MGMT_KEY=
TAOSCOPE_ANTHROPIC_API_KEY=
TAOSCOPE_AI_MODEL=google/gemini-2.5-flash
TAOSCOPE_AI_EFFORT=medium
TAOSCOPE_AI_DAILY_LIMIT=100

# ---- competition tracking (per-subnet dashboards) ----
TAOSCOPE_COMP_ENABLED=true

# ---- GitHub repo watching ----
# STRONGLY RECOMMENDED once more than a couple of subnets are tracked.
# Unauthenticated GitHub allows 60 requests/hour PER IP, shared by every
# adapter's repo watcher. A 304 is free, so a settled watcher costs almost
# nothing -- but first sights, real commits and range compares all cost 1, and
# once the budget hits zero GitHub 403s EVERYTHING including conditional
# requests, so the watcher goes blind exactly when a rules commit lands.
# A classic token with NO scopes (public read only) raises this to 5,000/hour:
#   https://github.com/settings/tokens  ->  "Generate new token (classic)",
#   tick nothing, paste below.
TAOSCOPE_GITHUB_TOKEN=

# ---- API credit monitoring ----
# A provider with no key is skipped entirely, never reported as zero.
TAOSCOPE_LIUM_API_KEY=
TAOSCOPE_LIUM_API_BASE=https://lium.io/api
TAOSCOPE_CHUTES_API_KEY=
TAOSCOPE_PARALLEL_API_KEY=
TAOSCOPE_PARALLEL_OAUTH_TOKEN=
TAOSCOPE_VERCEL_API_TOKEN=
TAOSCOPE_VERCEL_TEAM_ID=
TAOSCOPE_CREDITS_PROVIDERS=lium,openrouter,chutes
TAOSCOPE_CREDITS_POLL=900
# Balance levels (USD) that trigger a one-shot alert as they are crossed downward.
TAOSCOPE_CREDITS_THRESHOLDS=100,50,20,10,5,1
